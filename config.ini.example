; Config for run_pipeline.py (v3, ccdproc)
; Steps run in order: bias -> dark -> flat -> calibration -> combination.
; Commented lines (;) = the built-in defaults from the scripts; uncomment
; only what you want to change. Scripts run standalone always use the
; built-in defaults.

[paths]
; Folder holding the Bias / Dark / Flat / Light subfolders
images_path = /path/to/calibration_files
; Output folder for all products (relative to images_path, or absolute).
; The masters, calibrated and combined frames go into subfolders of it.
; Leave empty to write them directly under images_path.
output_folder = processed
; Subfolder names inside output_folder (defaults shown; each may also be an
; absolute path, which then wins over output_folder).
;masters_folder = masters
;calibrated_folder = calibrated
;combined_folder = combined

[steps]
; true / false for each step
master_bias = true
master_dark = true
master_flat = true
calibration = true
combination = true

[general]
; Grouping and master matching are done on SET-TEMP (exact); a frame is
; dropped when |CCD-TEMP - SET-TEMP| exceeds this threshold [deg C]
temp_match_tol = 1.0
; Approximate RAM ceiling for combination [MB]. Higher = fewer chunks in
; ccdproc.combine; keep it below the RAM actually available.
mem_budget_mb = 2048
; Threads used for the per-frame reads and reductions. Frame I/O dominates
; the runtime (especially over /mnt in WSL). 1 = fully sequential.
io_workers = 4

[master_settings]
; Common settings for all masters (bias / dark / flat).
; Master combine method: average (recommended, astropy guide) or median
combine_method = average
; Sigma clipping at combination (astropy guide: 5/5)
sigma_clip_low = 5.0
sigma_clip_high = 5.0
; Below this frame count a group produces NO master at all (bias/dark/flat).
; Guards against a stray GAIN / XBINNING / SET-TEMP typo splitting a few
; frames into their own group. Set 1 to allow single-frame masters.
min_frames_for_master = 5
; QC bias/dark: below this frame count, only warn - never reject
min_frames_for_qc = 10
; QC: reject if |median - group| > median_sigma * MAD + median_floor_adu
median_sigma = 5.0
median_floor_adu = 5.0
; QC: reject if frame noise is outside [group/x, group*x]
std_ratio_max = 2.0
; Frame pairs used to estimate read noise / pair noise
max_rn_pairs = 8
; Per-frame QC statistics are measured on a [::N, ::N] grid. They only drive
; quality control, never the combined pixels. 1 = full-array statistics.
stats_subsample = 4

[master_bias]
; (no specific settings - uses [master_settings])

[master_dark]
; Build darks from raw frames, without bias subtraction (recommended CMOS)
no_bias = true
; Anti-damage: bias is NOT applied when the GROUP median would drop below
; -this threshold [ADU], or when more than half the frames would. Single
; frames dipping slightly below zero only produce a note.
neg_median_tol_adu = 0.2

[master_flat]
; Allow scaling a dark of a different exposure (bias-subtracted only)
dark_scale = false
; QC flats: minimum frame count, ADC saturation, median limits
min_frames_for_qc = 5
saturation_adu = 65535
sat_median_frac = 0.90
min_median_frac = 0.05

[calibration]
; Allow scaling the dark when calibrating lights
dark_scale = false
; Pixels with a flat below this threshold are clamped to it (min_value)
flat_min = 0.2
; Cosmic-ray rejection (L.A.Cosmic) on each calibrated frame; needs astroscrappy
fix_cosmic_rays = false
cr_sigclip = 4.5
cr_objlim = 5.0
cr_readnoise = 8.0
; Hot-pixel repair: interpolate pixels flagged from the master dark
; (threshold = clipped_median + sigma * clipped_std of the master dark).
; The clipped std tracks the master's noise floor rather than the exposure,
; so a low sigma flags far more pixels on long darks than on short ones.
; A high sigma (~20) keeps the repaired fraction small and roughly constant
; across exposures - only pixels dark subtraction genuinely cannot fix.
fix_hot_pixels = true
hot_pixel_sigma = 20.0

[combination]
; Combination method: mean / median / sum / sclip
method = sclip
