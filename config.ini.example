[GENERAL]
debug = yes

[MASTERS]
# Root directory where you have the BIAS/DARK/FLAT sub folders with raw
raw_root = ./raw

# Where are the masters saved
master_output = ./masters

# Building master BIAS
build_bias = yes

# Building master DARK
build_dark = yes
dark_no_bias = no
dark_scale = no

# Building master FLAT
build_flat = yes
flat_no_bias = no
flat_dark_scale = no

# Memory limit for frame combination (MB). Increase for faster processing
# if you have enough RAM, decrease if you get out-of-memory errors.
mem_limit_mb = 2048

[CALIBRATION]
# Run calibration of science frames (yes/no)
run_calibration = yes

# The type of scientific frames (IMAGETYP in the header), e.g. LIGHT, OBJECT, etc.
file_type = LIGHT

# Root directory with subfolder <file_type> (ex: ./raw/LIGHT)
input_root = ./raw

# Where to write calibrated FITS
output_dir = ./calibrated

# Where are the masters read from (folder or files)
master_files = ./masters

# Calibration options
no_bias = no
dark_scale = no

# Hot pixel correction
# Pixels in the master dark above  clipped_median + hot_pixel_sigma * clipped_std  are flagged
# and interpolated from their 3x3 neighbours in every LIGHT frame.
fix_hot_pixels = yes
hot_pixel_sigma = 5.0

# Cosmic ray rejection (L.A.Cosmic algorithm)
# Applied to each calibrated LIGHT frame after bias+dark+flat correction.
# cr_readnoise is used only when RDNOISE is absent from the FITS header.
fix_cosmic_rays = yes
cr_sigclip   = 4.5
cr_objlim    = 5.0
cr_readnoise = 8.0
